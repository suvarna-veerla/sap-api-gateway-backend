<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://w3.org" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <groupId>com.hcl.gateway</groupId>
    <artifactId>my-api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <!-- స్ప్రింగ్ బూట్ పేరెంట్ కాన్ఫిగరేషన్ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.2</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- స్ప్రింగ్ బూట్ వెబ్ సర్వర్ (Tomcat) మరియు REST API కోసం -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- స్ప్రింగ్ బూట్ అప్లికేషన్‌ను రన్ చేయడానికి ప్లగిన్ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
